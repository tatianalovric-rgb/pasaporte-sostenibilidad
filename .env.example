# ESCALA ESG — variables de entorno
#
# Si estas dos variables están presentes, la app usa Supabase.
# Si faltan, usa una base SQLite local (data.db) sin configuración alguna.
#
# Dónde obtenerlas: panel de Supabase → tu proyecto → Project Settings → API
#   SUPABASE_URL       = "Project URL"
#   SUPABASE_ANON_KEY  = clave service_role si activaste RLS sin políticas (recomendado),
#                        o la clave anon si añadiste la política de prototipo.
#
# Estas variables se leen SOLO en el servidor. Nunca les pongas el prefijo VITE_,
# porque eso las incrustaría en el paquete JavaScript que descarga el navegador.

SUPABASE_URL=
SUPABASE_ANON_KEY=
